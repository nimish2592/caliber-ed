# App
# Local: http://localhost:3000
# Production (Vercel): https://caliber.clipera.in
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=change-me-to-a-long-random-string

# Dedicated Higher-Ed Supabase — never hiring_dev / Hiring_Portal.
# Create a new project, then paste Project URL + anon/publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Dashboard → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=
# Dashboard → Settings → Database
SUPABASE_DB_PASSWORD=

# CV files go to a private Supabase bucket, grouped by campus then login or public goal link:
#   {institution-slug}/login/{email}/{assessment-id}/{filename}
#   {institution-slug}/goal/{goal-slug}/{assessment-id}/{filename}
STORAGE_DRIVER=supabase
STORAGE_BUCKET=cv-uploads
# STORAGE_DRIVER=local
# Local CV fallback is always .data/uploads (gitignored).

# Postgres for this project (never Caliber hiring).
# Prefer Session pooler (IPv4) — direct db.[ref].supabase.co is IPv6-only and often ENOTFOUND locally/Vercel.
# SUPABASE_DB_REGION=ap-southeast-2
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# If DATABASE_URL is unset and SUPABASE_DB_REGION + SUPABASE_DB_PASSWORD are set, the pooler URI is built automatically.

# Optional. Leave unset to use the built-in heuristic engine (swappable later).
# ASSESSMENT_ENGINE=heuristic
# ASSESSMENT_ENGINE=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional later: Caliber extract-only API. Do not copy Caliber secrets.
# CALIBER_CV_API_URL=
# CALIBER_CV_API_KEY=

# Demo campus login (local seed only)
DEMO_ADMIN_EMAIL=campus@demo.edu
DEMO_ADMIN_PASSWORD=campus-demo

# Platform admin who provisions organizations. Use the Gmail that will sign in.
# /admin is limited to nimish.khandelwal25@gmail.com and nimish.khandelwal2592@gmail.com.
PLATFORM_ADMIN_EMAIL=nimish.khandelwal25@gmail.com
PLATFORM_ADMIN_PASSWORD=platform-demo
# Optional comma-separated extras (still must be platform institution users):
# PLATFORM_ADMIN_EMAILS=

# Google login goes through Supabase Auth (not the app's own OAuth client).
# 1. Supabase → Authentication → Providers → Google: enable and paste Client ID + Secret
# 2. Google Cloud → Web client Authorized redirect URI (only this):
#    {NEXT_PUBLIC_SUPABASE_URL}/auth/v1/callback
# 3. Supabase → Authentication → URL Configuration
#    Site URL: https://caliber.clipera.in
#    Redirect URLs:
#      http://localhost:3000/api/auth/google/callback
#      https://caliber.clipera.in/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Resend — staff-triggered student report emails only (never auto-send after upload).
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Caliber <reports@yourdomain.com>
# Use a verified domain in Resend. For tests: onboarding@resend.dev
